+// Detaching every tiled target destroys Dwindle's tree. Keep an independent
+// copy before the first detach, with weak target references. Only restore it
+// when the same algorithm and exact target set are still alive.
+struct SCanvasDwindleTree {
+    WP<Layout::CAlgorithm> algorithm;
+    const Layout::ITiledAlgorithm* tiledInstance = nullptr;
+    std::vector<SP<Layout::Tiled::SDwindleNodeData>> nodes;
+};
+static std::unordered_map<WORKSPACEID, SCanvasDwindleTree> g_canvasDwindleTrees;
+
+static void saveCanvasDwindleTree(const PHLWINDOW& window) {
+    const auto WS = window ? window->m_workspace : nullptr;
+    const auto ALGO = WS && WS->m_space ? WS->m_space->algorithm() : nullptr;
+    auto* dwindle = ALGO ? dc<Layout::Tiled::CDwindleAlgorithm*>(ALGO->m_tiled.get()) : nullptr;
+    if (!dwindle || g_canvasDwindleTrees.contains(WS->m_id))
+        return;
+    SCanvasDwindleTree saved{.algorithm = ALGO, .tiledInstance = dwindle};
+    std::unordered_map<const Layout::Tiled::SDwindleNodeData*, SP<Layout::Tiled::SDwindleNodeData>> copies;
+    for (const auto& node : dwindle->m_dwindleNodesData) {
+        auto copy = makeShared<Layout::Tiled::SDwindleNodeData>(*node);
+        copies.emplace(node.get(), copy);
+        saved.nodes.push_back(copy);
+    }
+    const auto cloneRef = [&](const WP<Layout::Tiled::SDwindleNodeData>& ref) -> WP<Layout::Tiled::SDwindleNodeData> {
+        const auto original = ref.lock();
+        const auto it = copies.find(original.get());
+        return it == copies.end() ? WP<Layout::Tiled::SDwindleNodeData>{} : it->second;
+    };
+    for (auto& node : saved.nodes) {
+        node->pParent = cloneRef(node->pParent);
+        node->children[0] = cloneRef(node->children[0]);
+        node->children[1] = cloneRef(node->children[1]);
+        node->self = node;
+    }
+    g_canvasDwindleTrees.emplace(WS->m_id, std::move(saved));
+}
+
+static void restoreCanvasDwindleTrees() {
+    for (auto& [id, saved] : g_canvasDwindleTrees) {
+        const auto ALGO = saved.algorithm.lock();
+        auto* dwindle = ALGO ? dc<Layout::Tiled::CDwindleAlgorithm*>(ALGO->m_tiled.get()) : nullptr;
+        if (!dwindle || dwindle != saved.tiledInstance)
+            continue;
+        std::unordered_set<const Layout::ITarget*> original, current;
+        bool validTree = true;
+        for (const auto& node : saved.nodes) {
+            if (node->isNode)
+                continue;
+            const auto TARGET = node->pTarget.lock();
+            if (!TARGET || TARGET->floating() || TARGET->space() != ALGO->space()) {
+                validTree = false;
+                break;
+            }
+            original.emplace(TARGET.get());
+        }
+        for (const auto& ref : ALGO->m_tiledTargets) {
+            if (const auto target = ref.lock())
+                current.emplace(target.get());
+        }
+        // New, closed or moved windows need the newly built live tree.
+        if (!validTree || original != current)
+            continue;
+        dwindle->m_dwindleNodesData = std::move(saved.nodes);
+        dwindle->recalculate();
+    }
+    g_canvasDwindleTrees.clear();
+}
