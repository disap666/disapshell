#!/usr/bin/python
import os
from pathlib import Path
import sys
base=Path.home()/'.local/share/wallpaper-picker'
(Path.home()/'.cache/wallpaper-picker').mkdir(parents=True,exist_ok=True)
script=base/('backend.py' if len(sys.argv)>1 else 'gallery.py')
os.execv('/usr/bin/python',['/usr/bin/python',str(script),*sys.argv[1:]])
