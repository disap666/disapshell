#!/bin/sh
# Theme carousel (quickshell RiceThemes). Starts the daemon on first use.
if qs ipc -c RiceThemes call themes toggle >/dev/null 2>&1; then exit 0; fi
qs -d -n -c RiceThemes >/dev/null 2>&1
for attempt in $(seq 1 40); do
    if qs ipc -c RiceThemes call themes open >/dev/null 2>&1; then exit 0; fi
    sleep 0.1
done
exit 1
