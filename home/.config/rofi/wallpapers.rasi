configuration {
    show-icons: true;
    font: "JetBrains Mono 11";
}
* {
    bg: #1e1e2edb;
    fg: #cdd6f4;
    accent: #cba6f7;
    background-color: transparent;
    text-color: @fg;
}
window {
    width: 1180px;
    border: 2px;
    border-color: #cba6f780;
    border-radius: 22px;
    background-color: @bg;
    padding: 24px;
}
mainbox { spacing: 18px; children: [ inputbar, message, listview ]; }
inputbar {
    spacing: 12px;
    padding: 12px 16px;
    border-radius: 12px;
    background-color: #313244bb;
    children: [ prompt, entry ];
}
prompt { text-color: @accent; }
entry { placeholder: "Поиск обоев"; placeholder-color: #9399b2; }
message { padding: 0px 4px; }
textbox { text-color: #a6adc8; }
listview {
    layout: horizontal;
    columns: 5;
    lines: 1;
    spacing: 12px;
    fixed-height: true;
    cycle: true;
    scrollbar: false;
}

element {
    orientation: vertical;
    padding: 10px;
    spacing: 8px;
    border-radius: 12px;
    background-color: #31324488;
}
element selected { background-color: #585b70dd; text-color: @accent; }
element-icon { size: 190px; horizontal-align: 0.5; }
element-text { horizontal-align: 0.5; vertical-align: 0.5; }
