{
  "layer": "bottom",
  "position": "top",
  "height": 40,
  "margin-top": 10,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 2,
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "custom/search",
    "clock#date",
    "custom/rice-gap-1",
    "memory"
  ],
  "modules-center": [
    "custom/media",
    "custom/previous",
    "custom/play",
    "custom/next",
    "hyprland/window",
    "clock",
    "temperature",
    "hyprland/language"
  ],
  "modules-right": [
    "custom/telegram",
    "hyprland/language",
    "network",
    "bluetooth",
    "pulseaudio",
    "battery",
    "custom/notification",
    "backlight"
  ],
  "custom/launcher": {
    "format": "",
    "tooltip-format": "Система",
    "on-click": "kitty -e btop",
    "on-click-right": "hyprlock"
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "all-outputs": false,
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8
      ]
    },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "format-icons": {
      "default": "",
      "active": "━",
      "urgent": "!"
    }
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%d %b · %H:%M}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format": "{ifname} · {essid}\n{ipaddr}",
    "on-click": "@HOME@/.local/bin/connectivity-widget",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\n{ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "tooltip-format-ethernet": "LAN · {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "on-click-right": "@HOME@/.local/bin/connectivity-widget --bluetooth"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "scroll-step": 3,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "max-volume": 100,
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "tooltip-format": "Громкость · {volume}%\n{desc}"
  },
  "battery": {
    "bat": "BAT1",
    "interval": 20,
    "states": {
      "warning": 25,
      "critical": 12
    },
    "format": " {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip-format": "{timeTo} · {power:.1f} W"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "",
    "tooltip-format": "Bluetooth · {status}",
    "tooltip-format-connected": "{device_alias}",
    "on-click": "@HOME@/.local/bin/connectivity-widget --bluetooth"
  },
  "custom/notification": {
    "format": "{}",
    "return-type": "json",
    "exec": "qs ipc -c RiceDesktop call notifications status",
    "on-click": "@HOME@/.local/bin/rice-notifications",
    "on-click-right": "@HOME@/.local/bin/rice-notifications --dnd",
    "escape": true,
    "tooltip": true,
    "interval": 2
  },
  "margin-bottom": 0,
  "fixed-center": true,
  "custom/search": {
    "format": "",
    "on-click": "@HOME@/.local/bin/rice-apps",
    "tooltip-format": "Приложения"
  },
  "clock#date": {
    "format": "{:%d %b}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "custom/media": {
    "exec": "@HOME@/.config/waybar/media-status.py",
    "return-type": "json",
    "interval": 3,
    "max-length": 14,
    "on-click": "@HOME@/.local/bin/media-toggle",
    "on-click-right": "spotify"
  },
  "custom/previous": {
    "format": "󰒮",
    "on-click": "playerctl previous",
    "tooltip-format": "Предыдущий трек"
  },
  "custom/play": {
    "format": "󰐊",
    "on-click": "@HOME@/.local/bin/media-toggle",
    "tooltip-format": "Пауза / воспроизведение"
  },
  "custom/next": {
    "format": "󰒭",
    "on-click": "playerctl next",
    "tooltip-format": "Следующий трек"
  },
  "temperature": {
    "thermal-zone": 0,
    "interval": 10,
    "format": " {temperatureC}°",
    "critical-threshold": 90,
    "tooltip-format": "Температура процессора: {temperatureC}°C",
    "on-click": "kitty -e btop"
  },
  "custom/telegram": {
    "format": "",
    "tooltip-format": "Telegram",
    "on-click": "Telegram"
  },
  "hyprland/language": {
    "format": "{short}",
    "format-en": "EN",
    "format-ru": "RU",
    "format-uk": "UA",
    "on-click": "hyprctl switchxkblayout all next"
  },
  "cpu": {
    "format": "󰍛 {usage}%",
    "interval": 3,
    "on-click": "kitty -e btop"
  },
  "memory": {
    "format": "󰘚 {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
  },
  "disk": {
    "format": "󰋊 {percentage_used}%",
    "interval": 30,
    "path": "/"
  },
  "backlight": {
    "format": "󰃠 {percent}%",
    "scroll-step": 5
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    }
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 25,
    "separate-outputs": true
  },
  "mpris": {
    "format": "󰎆 {artist} - {title}",
    "format-paused": "󰏤 {title}",
    "max-length": 28
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "on-click": "activate",
    "on-click-middle": "close",
    "tooltip-format": "{title}"
  },
  "custom/rice-gap-1": {
    "format": " ",
    "tooltip": false
  }
}
