// Image logo · silver monochrome layout
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "@HOME@/.config/fastfetch/ff-transparent.png",
    "width": 38,
    "height": 13,
    "padding": {
      "left": 1,
      "right": 3,
      "top": 0
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 0
    },
    "color": {
      "keys": "#b6adbf",
      "output": "#ddd9df"
    },
    "hideCursor": false,
    "size": {
      "ndigits": 1
    }
  },
  "modules": [
    "break",
    "break",
    "break",
    "break",
    {
      "type": "os",
      "key": "",
      "format": "{name} {arch}"
    },
    {
      "type": "kernel",
      "key": "",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": ""
    },
    {
      "type": "shell",
      "key": ""
    },
    {
      "type": "terminal",
      "key": ""
    },
    {
      "type": "cpu",
      "key": "",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "󰢮",
      "format": "{name}",
      "hideType": "integrated"
    },
    {
      "type": "memory",
      "key": "󰍛",
      "format": "{used} / {total}"
    },
    {
      "type": "uptime",
      "key": "󰔟"
    },
    "break",
    "break",
    "break",
    {
      "type": "custom",
      "format": "{##b9b8c0}───────────────────────────────❦"
    },
    "break",
    "break"
  ]
}
