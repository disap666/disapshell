# Lavender glass: matches Kitty, Waybar and the application dock.
[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1
center_align = 1
autosens = 1
sensitivity = 100
lower_cutoff_freq = 50
higher_cutoff_freq = 10000
sleep_timer = 10

[input]
method = pulse
source = auto

[output]
method = noncurses
orientation = bottom
channels = stereo
show_idle_bar_heads = 1

[color]
background = default
foreground = '#c6acee'
gradient = 1
gradient_count = 5
gradient_color_1 = '#4a3b60'
gradient_color_2 = '#705789'
gradient_color_3 = '#9577b3'
gradient_color_4 = '#c6acee'
gradient_color_5 = '#eee7fa'

[smoothing]
noise_reduction = 80
